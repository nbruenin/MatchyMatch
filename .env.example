# Environment Variables for MatchyMatch

# Puzzle Configuration
# Index of the puzzle to display (0-19)
# If not set or invalid, defaults to 0
VITE_PUZZLE_INDEX=0

# Development Server
# Set to true to enable verbose logging
DEBUG=false

# Note: This file is a template. Copy to .env.local for local development.
# Never commit actual .env files with secrets to the repository.
