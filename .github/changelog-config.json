{
  "categories": [
    {
      "title": "## 🚀 Features",
      "labels": ["enhancement", "feature"]
    },
    {
      "title": "## 🐛 Bug Fixes",
      "labels": ["bug", "fix"]
    },
    {
      "title": "## 🔒 Security",
      "labels": ["security"]
    },
    {
      "title": "## 📚 Documentation",
      "labels": ["documentation", "docs"]
    },
    {
      "title": "## 🧪 Tests",
      "labels": ["test"]
    },
    {
      "title": "## 🔧 Maintenance",
      "labels": ["chore", "dependencies", "ci"]
    },
    {
      "title": "## ⚡ Performance",
      "labels": ["performance", "perf"]
    }
  ],
  "ignore_labels": ["ignore", "wontfix", "duplicate", "invalid"],
  "sort": "ASC",
  "template": "${{CHANGELOG}}\n\n**Full Changelog**: ${{RELEASE_DIFF}}",
  "pr_template": "- ${{TITLE}} (#${{NUMBER}})",
  "empty_template": "- No changes",
  "label_extractor": [
    {
      "pattern": "^feat(\\(.+\\))?:",
      "target": "enhancement"
    },
    {
      "pattern": "^fix(\\(.+\\))?:",
      "target": "bug"
    },
    {
      "pattern": "^docs(\\(.+\\))?:",
      "target": "documentation"
    },
    {
      "pattern": "^test(\\(.+\\))?:",
      "target": "test"
    },
    {
      "pattern": "^chore(\\(.+\\))?:",
      "target": "chore"
    },
    {
      "pattern": "^perf(\\(.+\\))?:",
      "target": "performance"
    }
  ]
}
